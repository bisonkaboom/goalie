# Supabase project (Dashboard > Project Settings > API Keys, and > Data API for the URL)
NEXT_PUBLIC_SUPABASE_URL=
# Newer projects show `sb_publishable_...`. If yours shows a long JWT labelled
# `anon` instead, use NEXT_PUBLIC_SUPABASE_ANON_KEY — the app accepts either.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase brokers Google OAuth, so the Google client ID/secret live in the
# Supabase dashboard (Authentication > Sign In / Providers > Google), not here.
#
# Google Cloud Console > Credentials > OAuth client:
#   Authorized redirect URI:  https://<project-ref>.supabase.co/auth/v1/callback
#
# Supabase > Authentication > URL Configuration:
#   Site URL:       http://localhost:3000
#   Redirect URLs:  http://localhost:3000/**
